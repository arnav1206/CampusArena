# Campus Arena — Environment Variables
# Copy this file to .env and fill in your credentials

# ── Email OTP (Gmail) ─────────────────────────────────────────────────────────
# Create an App Password at https://myaccount.google.com/apppasswords
# Make sure "Less secure app access" or 2FA + App Password is enabled
GMAIL_USER=your.email@gmail.com
GMAIL_PASS=your-app-password-here

# ── SMS OTP (Fast2SMS — free Indian SMS API) ──────────────────────────────────
# Get a free API key at https://fast2sms.com/
FAST2SMS_KEY=your-fast2sms-api-key-here

# ── Platform administrator ──────────────────────────────────────────────────
# This exact email receives the platform-admin role after it verifies a real OTP.
# Replace it with an inbox you control before deployment.
PLATFORM_ADMIN_EMAIL=platform.admin@campusarena.in
PLATFORM_ADMIN_NAME=Platform Admin

# Used to sign administrator sessions. Generate a long random value and keep it secret.
AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
